{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CampusBank ATM",
  "version": "0.1.0",
  "identifier": "com.university.campusbank.atm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CampusBank ATM",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
